          "n_large_image": "https://akm-img-a-in.tosshub.com/indiatoday/images/story/202608/csir-scientist-dr-akanksha-singh-completes-hat-trick-of-science-honours-in-2026-095145165-16x9_0.jpg?VersionId=6NgcQVq7rXL36FtO0mQwmmVAY..oOSoW&size=555:313",
