          "n_one_to_one_image": "https://akm-img-a-in.tosshub.com/indiatoday/images/story/202608/csir-scientist-dr-akanksha-singh-completes-hat-trick-of-science-honours-in-2026-095145169-1x1.jpg?VersionId=Q5NcUcW4Ztbpjq_ohIdTfrfa2o8iyzhV",
